{
  "name": "dadajam",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --disable-warning=ExperimentalWarning --test tools/*.test.mjs",
    "check": "npm test && node tools/check-graphics.ts && node tools/check-gpu-timing.ts && node tools/check-machine-boxes.ts && node tools/check-teardown-order.ts && node tools/check-machines.ts",
    "dev": "concurrently -k -n server,client -c blue,green \"npm:dev:server\" \"vite\"",
    "dev:server": "node --watch-path=server --watch-path=shared server/index.ts --lab",
    "build": "tsc --noEmit && vite build && node tools/manifest.ts && node tools/precompress.ts",
    "start": "node server/index.ts",
    "preview": "npm run build && npm start",
    "perf": "node tools/perf.ts",
    "econ": "node --no-warnings tools/econsim/cli.ts",
    "bench": "node --no-warnings tools/bench/cli.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.2",
    "@webgpu/types": "^0.1.74",
    "concurrently": "^10.0.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "obscenity": "^0.4.6",
    "sirv": "^3.0.2",
    "three": "^0.186.1",
    "ws": "^8.22.0"
  }
}
