{
  "name": "dadajam",
  "private": true,
  "type": "module",
  "scripts": {
    "asbuild": "asc assembly/index.ts --target release",
    "dev": "npm run asbuild && concurrently -k -n server,client -c blue,green \"npm:dev:server\" \"vite\"",
    "dev:server": "node --watch-path=server --watch-path=shared server/index.ts",
    "build": "npm run asbuild && tsc --noEmit && vite build && node tools/precompress.ts",
    "start": "node server/index.ts",
    "preview": "npm run build && npm start"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.2",
    "@webgpu/types": "^0.1.74",
    "assemblyscript": "^0.28.20",
    "concurrently": "^10.0.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "sirv": "^3.0.2",
    "three": "^0.186.1",
    "ws": "^8.22.0"
  }
}
