# Runs inside the container; host Caddy on maukass proxies herkku.org/dadajam/* here.
:80 {
	root * /srv
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		Cache-Control no-cache
	}
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	file_server
}
